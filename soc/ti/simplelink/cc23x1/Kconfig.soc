# This symbol is also defined in modules/Kconfig.simplelink when the HAL
# module is present. It is defined here to keep the SoC tree self-contained
# for the KconfigHWMv2 compliance check.

config HAS_CC23X1_SDK
	bool

config SOC_SERIES_CC23X1
	bool
	select SOC_FAMILY_TI_SIMPLELINK
	help
	  Enable support for TI SimpleLink CC23X1 series SOCs.

config SOC_CC2341R10
	bool
	select SOC_SERIES_CC23X1
	help
	  CC2341R10

config SOC_SERIES
	default "cc23x1" if SOC_SERIES_CC23X1

config SOC
	default "cc2341r10" if SOC_CC2341R10
