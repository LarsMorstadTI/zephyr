/dts-v1/;

#include <ti/cc2341r10.dtsi>
#include "lp_em_cc2341r10-pinctrl.dtsi"
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "TI CC2341R10 LaunchPad";
	compatible = "ti,lp_em_cc2341r10";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		sw0 = &btn0;
		sw1 = &btn1;
		watchdog0 = &wdt0;
		rtc = &rtc0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
			label = "Green LED";
		};

		led1: led_1 {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
			label = "Red LED";
		};
	};

	keys {
		compatible = "gpio-keys";

		btn0: btn_0 {
			gpios = <&gpio0 23 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button 1";
			zephyr,code = <INPUT_KEY_0>;
		};

		btn1: btn_1 {
			gpios = <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Button 2";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	lfxosc: lf_xosc {
		compatible = "ti,cc23x0-lf-xosc";
	};
};

&cpu0 {
	clock-frequency = <48000000>;
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_rx_default &uart0_tx_default>;
	pinctrl-names = "default";
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_sck_default
		     &spi0_pico_default
		     &spi0_poci_default
		     &spi0_cs_default>;
	pinctrl-1 = <&spi0_sck_sleep
		     &spi0_pico_sleep
		     &spi0_poci_sleep
		     &spi0_cs_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;

	mx25r80: mx25r8035f@0 {
		status = "okay";
		compatible = "jedec,spi-nor";
		reg = <0>;
		zephyr,pm-device-runtime-auto;
		spi-max-frequency = <12000000>;
		size = <0x800000>;
		jedec-id = [c2 28 14];
		has-dpd;
		dpd-wakeup-sequence = <30000 20 35000>;
		t-enter-dpd = <10000>;
		sfdp-bfp = [e5 20 f1 ff ff ff 7f 00 44 eb 08 6b 08 3b 04 bb
			    ee ff ff ff ff ff 00 ff ff ff 00 ff 0c 20 0f 52
			    10 d8 00 ff 23 72 f5 00 82 ed 04 b7 44 83 38 44
			    30 b0 30 b0 f7 c4 d5 5c 00 be 29 ff f0 d0 ff ff];
	};
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_scl_default &i2c0_sda_default>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
};

&lgpt0 {
	clk-prescale = <32>;
	status = "okay";
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc0_ch0 &adc0_ch2>;
	pinctrl-names = "default";
};

&comparator {
	status = "okay";
	pinctrl-0 = <&lpcmp_pos0_default &lpcmp_out0_default>;
	pinctrl-names = "default";
	positive-mux-input = "VA_PAD_A1";
	negative-mux-input = "VDDD";
	input-division-factor = "VIN_1_2";
	division-input = "DIVISION_INPUT_NEGATIVE";
	enable-output-pin;
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-names = "default";
};
